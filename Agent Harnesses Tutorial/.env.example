# Copy to .env and fill in. Never commit .env.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=DEFAULT
# Models (Unity Gateway names). Open-weight for all three, or each harness on its own model.
OPEN_MODEL=system.ai.kimi-k3
HERMES_OPEN_MODEL=databricks-kimi-k3
CLAUDE_MODEL=system.ai.claude-opus-5-5
CODEX_MODEL=system.ai.gpt-6-1-sol
HERMES_FRONTIER_MODEL=databricks-claude-opus-5-5
# SQL warehouse used by costs.py to read system.ai_gateway.usage
WAREHOUSE_ID=<warehouse-id>
