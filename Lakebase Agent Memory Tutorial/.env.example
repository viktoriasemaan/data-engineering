# Copy to .env and set your Databricks CLI profile (see `databricks auth profiles`).
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Each step of the walkthrough turns on one more kind of memory. Leave these unset to start with none.
# AGENT_SESSION_STORE=bean-byte-sessions        # step 2: conversations survive restarts
# AGENT_MEMORY_STORE=bean-byte-memory           # step 3: facts about each user persist across conversations
# AGENT_TRANSCRIPT_STORE=bean-byte-transcripts  # step 4: plain transcripts for the memory pipeline
# AGENT_MEMORY_WRITES=pipeline                  # step 4: the agent only reads memory; the pipeline writes it
